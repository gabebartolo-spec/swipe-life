    "up": {"label": "Take over and delegate by threat", "effects": {"smarts": 5, "career": 2, "relationships": -2}, "risk": {"chance": 0.5, "effects": {"relationships": -6, "stress": 6}, "result": "They do their bit. They also tell everyone you are a tyrant."}}
  },
  {

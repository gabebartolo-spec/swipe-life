  , "up": {"label": "Quit every app for a month", "effects": {"health": 5, "smarts": 5, "stress": -6}, "risk": {"chance": 0.5, "effects": {"relationships": -6, "happiness": -4}, "result": "Nobody knows where the party is. You miss it."}}},
  {
    "id": "t13_crush_notes",

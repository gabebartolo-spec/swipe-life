  , "up": {"label": "Turn it into a stand-up bit", "effects": {"relationships": 8, "happiness": 5, "career": 2}, "risk": {"chance": 0.5, "effects": {"happiness": -7, "relationships": -4}, "result": "Silence. Then someone coughs."}}},
  {
    "id": "t13_first_phone",
    "text": "Your parents finally hand you a phone. It comes with a printed list of rules, two pages long, signed by both of them.",

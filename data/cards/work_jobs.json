  , "up": {"label": "Propose at the dinner table", "effects": {"relationships": 12, "happiness": 9, "stress": 6}, "risk": {"chance": 0.55, "effects": {"relationships": -10, "happiness": -8}, "result": "It goes badly. Your mother is silent."}}},
  {
    "id": "partner_quit_together", "ages": [14, 17], "requires": { "flags": ["dating_work_partner"], "not_flags": ["work_job_dating", "work_special_dating"] },
    "text": "Neither of you works there any more. No rota, no gossip. {partner} asks, honestly, what you even talk about now.",

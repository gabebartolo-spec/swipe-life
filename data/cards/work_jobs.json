  , "up": {"label": "Move abroad together next week", "effects": {"happiness": 10, "relationships": 12, "money": -150}, "risk": {"chance": 0.55, "effects": {"money": -200, "relationships": -7}, "result": "Visas are hard. Rent is harder."}}},
  {
    "id": "partner_jealous", "ages": [14, 17], "requires": { "flags": ["dating_work_partner"] },
    "text": "{partner} saw you laughing with someone new by the lockers and has questions. They ask them very calmly. That's worse.",
    "left": { "label": "Get defensive", "effects": { "stress": 6, "relationships": -6 } },

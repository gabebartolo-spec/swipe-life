  , "up": {"label": "Get engaged on the spot", "effects": {"relationships": 9, "happiness": 8, "stress": 5}, "risk": {"chance": 0.6, "effects": {"happiness": -12, "relationships": -8}, "result": "The answer is no. In the freezer. In front of {rival}."}}},

  {
    "id": "partner_after_work", "ages": [14, 17], "requires": { "flags": ["dating_work_partner"] },
    "text": "Your shift just ended and your feet ache. {partner} texts: \"Milkshakes? I'm buying.\" Then three cow emojis.",

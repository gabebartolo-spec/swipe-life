  , "up": {"label": "Show them every message, every day", "effects": {"relationships": 10, "karma": 3, "happiness": -1}, "risk": {"chance": 0.5, "effects": {"relationships": -6, "stress": 6}, "result": "They want to see it all. Every day. For ever."}}},
  {
    "id": "partner_breakup", "ages": [14, 17], "weight": 4, "requires": { "flags": ["dating_work_partner"] },

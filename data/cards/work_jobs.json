               "risk": { "chance": 0.3, "effects": { "stress": 4 }, "result": "{boss} now schedules you on opposite shifts." } }
  , "up": {"label": "Turn it into a staff event", "effects": {"relationships": 7, "happiness": 6, "karma": 3}, "risk": {"chance": 0.5, "effects": {"career": -5, "stress": 6}, "result": "HR has questions. So many questions."}}},
  {
    "id": "work_dating_distracted", "ages": [14, 17], "requires": { "job": "job", "flags": ["work_job_dating"] },
    "text": "You and {crush} were laughing at something stupid and the orders piled up. The printer is spitting tickets on the floor.",
    "left": { "label": "Get back to work", "effects": { "stress": 4 }, "job": { "performance": 2 } },
    "right": { "label": "One more joke", "effects": { "happiness": 3, "stress": 3 }, "risk": {"chance": 0.3, "effects": {"happiness": -2, "stress": 2}, "result": "Mostly fine. Mostly."}, "coworker": { "boss": -8 }, "job": { "performance": -5 } }
  , "up": {"label": "Take a joint week off", "effects": {"happiness": 8, "relationships": 7, "money": -80}, "risk": {"chance": 0.5, "effects": {"career": -6, "stress": 6}, "result": "{boss} calls it a holiday. You're on a warning."}}},
  {
    "id": "work_dating_fight", "ages": [14, 17], "requires": { "job": "job", "flags": ["work_job_dating"] },
    "text": "You and {crush} fought over text last night. You're rostered side by side all day. They're stacking cups very loudly.",
    "left": { "label": "Silent treatment", "effects": { "stress": 7, "happiness": -5 }, "coworker": { "crush": -8 }, "set_flags": ["work_job_awkward"] },
    "right": { "label": "Talk it out on break", "effects": { "stress": 4, "relationships": 4 }, "risk": {"chance": 0.3, "effects": {"relationships": -3, "stress": 2}, "result": "There was a catch."}, "coworker": { "crush": 8 } }
  , "up": {"label": "Make a scene and say it out loud", "effects": {"happiness": 3, "relationships": 3, "stress": -5}, "risk": {"chance": 0.6, "effects": {"career": -6, "relationships": -8}, "result": "The whole kitchen heard every word."}}},
  {
    "id": "work_awkward_shift", "ages": [14, 17], "requires": { "job": "job", "flags": ["work_job_awkward"] },
    "text": "Every time {crush} walks past, the room gets two degrees colder. Your coworkers have started eating lunch elsewhere.",
    "left": { "label": "Ask for different shifts", "effects": { "stress": 3 }, "risk": {"chance": 0.3, "effects": {"happiness": -3, "stress": 2}, "result": "Mostly fine. Mostly."}, "coworker": { "boss": -3 }, "clear_flags": ["work_job_awkward"] },
    "right": { "label": "Grit your teeth", "effects": { "stress": 7, "happiness": -4 } },
    "up": {"label": "Transfer to a different branch", "effects": {"stress": -7, "career": 3, "happiness": 3}, "risk": {"chance": 0.5, "effects": {"money": -100, "relationships": -4}, "result": "The new commute eats your life."}}
  },
  {
    "id": "work_breakup", "ages": [14, 17], "weight": 6, "requires": { "job": "job", "flags": ["work_job_dating"] },
    "text": "{crush} says \"we should talk\" in the walk-in freezer, between the frozen peas. Your breath fogs. That's never good.",
    "left": { "label": "Break up", "effects": { "happiness": -10, "stress": 6, "relationships": -6 }, "coworker": { "crush": -15 },

[
  {
    "id": "work_boss_praise", "ages": [14, 17], "requires": { "job": "job" },
    "text": "{boss} stops you mid-shift, loud enough for the whole floor. \"Good work today, {job}.\" Everyone heard.",
    "left": { "label": "Shrug it off", "effects": { "stress": 2 }, "coworker": { "boss": 3, "rival": -3 } },
    "right": { "label": "Thank them", "effects": { "happiness": 3, "stress": -2 }, "risk": {"chance": 0.3, "effects": {"happiness": -2, "stress": 2}, "result": "Mostly fine. Mostly."}, "coworker": { "boss": 6, "rival": -6 }, "job": { "performance": 4 } },
    "up": {"label": "Ask for a promotion on the spot", "effects": {"career": 7, "happiness": 5, "money": 345}, "risk": {"chance": 0.5, "effects": {"career": -4, "stress": 5}, "result": "{boss} laughs. Then goes quiet. Then goes cold."}}
  },
  {
    "id": "work_boss_blame", "ages": [14, 17], "requires": { "job": "job" },
    "text": "Something went wrong. The room has gone very quiet. {boss} is looking straight at you, and not blinking.",
    "left": { "label": "Take the blame", "effects": { "karma": 4, "stress": 5 }, "coworker": { "boss": -2 }, "job": { "performance": -4 } },
    "right": { "label": "Point at {rival}", "effects": { "karma": -4, "stress": 4 }, "coworker": { "rival": -12 }, "job": { "performance": 2 },
               "risk": { "chance": 0.4, "effects": { "stress": 5 }, "result": "{rival} had proof. Now you look worse." } },
    "up": {"label": "Expose the real cause with proof", "effects": {"karma": 6, "career": 5, "relationships": -2}, "risk": {"chance": 0.5, "effects": {"relationships": -6, "career": -5}, "result": "Everybody is cross with you. Even the innocent."}}
  },
  {
    "id": "work_rival_sabotage", "ages": [14, 17], "requires": { "job": "job" },
    "text": "Your station is sticky, upside down, the labels swapped. You didn't leave it that way. {rival} is humming.",
    "left": { "label": "Clean it up", "effects": { "stress": 5 }, "job": { "performance": 2 } },
    "right": { "label": "Confront {rival}", "effects": { "stress": 6, "happiness": 2 }, "coworker": { "rival": -10 },
               "risk": { "chance": 0.3, "effects": { "stress": 4 }, "result": "{boss} only saw you yelling." } },
    "up": {"label": "Sabotage {rival}'s station back, worse", "effects": {"happiness": 5, "career": 2, "karma": -4}, "risk": {"chance": 0.6, "effects": {"career": -6, "relationships": -5}, "result": "The camera caught every second."}}
  },
  {
    "id": "work_rival_credit", "ages": [14, 17], "requires": { "job": "job" },
    "text": "{rival} is telling {boss} about \"their\" idea, using your exact words. It was your idea. You wrote it on a napkin.",
    "left": { "label": "Let it go", "effects": { "happiness": -5, "stress": 4 }, "coworker": { "rival": 3 } },
    "right": { "label": "Speak up", "effects": { "stress": 5 }, "coworker": { "rival": -12, "boss": 3 }, "job": { "performance": 5 } },
    "up": {"label": "Present it live in the team meeting", "effects": {"career": 7, "smarts": 3, "relationships": -3}, "risk": {"chance": 0.5, "effects": {"career": -5, "stress": 6}, "result": "{boss} sides with {rival}. Awkward."}}
  },
  {
    "id": "work_rival_truce", "ages": [14, 17], "weight": 5, "requires": { "job": "job", "coworker": { "rival": [-100, -30] } },
    "text": "Closing time. The lights are half off. {rival} tears a stale muffin in two and holds out the bigger half to you.",
    "left": { "label": "Refuse", "effects": { "stress": 2 } },
    "right": { "label": "Take it", "effects": { "happiness": 2, "stress": -2 }, "risk": {"chance": 0.3, "effects": {"happiness": -2, "stress": 2}, "result": "It didn't go to plan."}, "coworker": { "rival": 20 },
               "result": "You talk for ten minutes. They're almost bearable." }
  , "up": {"label": "Propose a partnership", "effects": {"career": 5, "relationships": 6, "happiness": 4}, "risk": {"chance": 0.5, "effects": {"career": -4, "relationships": -5}, "result": "They steal your best idea. Again."}}},
  {
    "id": "work_friend_cover", "ages": [14, 17], "requires": { "job": "job" },
    "text": "There's a party on Saturday and everyone's going. You're rostered on. {friend} says they'll cover, no problem.",
    "left": { "label": "Work the shift", "effects": { "money": 20, "happiness": -4, "stress": 3 }, "job": { "performance": 3 } },
    "right": { "label": "Let {friend} cover", "effects": { "happiness": 4, "relationships": 4, "stress": -2 }, "coworker": { "friend": -4 },
               "risk": { "chance": 0.25, "effects": { "stress": 5 }, "result": "{boss} noticed the swap. Awkward Monday." } },
    "up": {"label": "Swap with the whole shift and run the party", "effects": {"happiness": 10, "relationships": 11, "career": -2}, "risk": {"chance": 0.45, "effects": {"career": -6, "stress": 5}, "result": "{boss} sees the photos."}}
  },
  {
    "id": "work_friend_favour", "ages": [14, 17], "requires": { "job": "job" },
    "text": "{friend} is sick and calls you, croaking. They beg you to cover their shift tonight, sneezing between the words.",
    "left": { "label": "Say no", "effects": { "stress": 2 }, "coworker": { "friend": -10 } },
    "right": { "label": "Cover it", "effects": { "money": 20, "karma": 3, "stress": 5 }, "coworker": { "friend": 12 }, "job": { "performance": 3 } }
  , "up": {"label": "Cover and learn their whole job", "effects": {"career": 9, "karma": 5, "money": 105, "stress": 6}, "risk": {"chance": 0.45, "effects": {"health": -5, "stress": 6}, "result": "You catch what they had."}}},
  {
    "id": "work_gossip", "ages": [14, 17], "requires": { "job": "job" },
    "text": "In the break room, over the kettle, someone whispers that {boss} and {rival} are related. Same nose. It explains a lot.",
    "left": { "label": "Stay out of it", "effects": { "stress": 2 } },
    "right": { "label": "Spread it", "effects": { "happiness": 2, "karma": -3, "stress": 2 }, "coworker": { "friend": 4, "rival": -8 },
               "risk": { "chance": 0.3, "effects": { "stress": 5 }, "result": "{boss} heard it came from you." } },
    "up": {"label": "Publish it in the staff newsletter", "effects": {"happiness": 9, "relationships": 4, "karma": -5}, "risk": {"chance": 0.5, "effects": {"career": -8, "relationships": -7}, "result": "The newsletter was read by {boss}."}}
  },
  {
    "id": "work_gossip_about_you", "ages": [14, 17], "requires": { "job": "job" },
    "text": "Apparently you're \"{boss}'s favourite\". The whole shift thinks so. Chat stops when you walk into the break room.",
    "left": { "label": "Ignore it", "effects": { "stress": 3 }, "risk": {"chance": 0.3, "effects": {"happiness": -3, "stress": 2}, "result": "Then it went a bit wrong."} },
    "right": { "label": "Work extra hard to prove it wrong", "effects": { "stress": 5 }, "job": { "performance": 5 } },
    "up": {"label": "Make it true and ask for a rise", "effects": {"career": 8, "money": 76, "karma": -3}, "risk": {"chance": 0.55, "effects": {"career": -7, "relationships": -6}, "result": "{boss} is confused. Then offended."}}
  },
  {
    "id": "work_raise", "ages": [14, 17], "weight": 6, "requires": { "job": "job", "coworker": { "boss": [20, 100] } },
    "text": "{boss} leans in: there might be \"a little extra\" in your pay this year. They hold two fingers very close together.",
    "left": { "label": "Say nothing", "effects": { "money": 25, "stress": 2 } },
    "right": { "label": "\"Thank you!\"", "effects": { "money": 40, "happiness": 3, "stress": -2 }, "risk": {"chance": 0.3, "effects": {"happiness": -2, "stress": 2}, "result": "Then it went a bit wrong."}, "coworker": { "boss": 3 } },
    "up": {"label": "Negotiate hard for a real raise", "effects": {"money": 400, "career": 11, "happiness": 3, "stress": 4}, "risk": {"chance": 0.4, "effects": {"money": -80, "career": -6}, "result": "{boss} withdraws the offer. Loudly."}}
  },
  {
    "id": "work_quit_moment", "ages": [14, 17], "weight": 5, "requires": { "job": "job", "stats": { "stress": [50, 100] } },
    "text": "Double shift, no break, feet throbbing. {boss} just called you \"the new kid\" again, in front of a customer.",
    "left": { "label": "Bite your tongue", "effects": { "stress": 6, "happiness": -4 } },
    "right": { "label": "Ask for a day off", "effects": { "stress": -6 }, "risk": {"chance": 0.3, "effects": {"happiness": -3, "stress": 2}, "result": "It didn't go to plan."}, "coworker": { "boss": -4 }, "job": { "performance": -3 } },
    "up": {"label": "Quit with a speech and a flourish", "effects": {"stress": -12, "happiness": 8, "career": -3}, "risk": {"chance": 0.55, "effects": {"money": -100, "career": -8}, "result": "Bills. A very quiet flat. A bad reference."}}
  },
  {
    "id": "work_near_fired", "ages": [14, 17], "weight": 6, "requires": { "job": "job", "coworker": { "boss": [-100, -20] } },
    "text": "{boss} wants a word, door closed. They don't sit down. \"One more slip and you're done.\" The wall clock ticks.",
    "left": { "label": "Apologise", "effects": { "stress": 6, "happiness": -4 }, "coworker": { "boss": 6 }, "job": { "performance": 4 } },
    "right": { "label": "Argue", "effects": { "stress": 5 }, "coworker": { "boss": -10 },
               "risk": { "chance": 0.4, "effects": { "happiness": -6 }, "result": "That was the slip." } },
    "up": {"label": "Beat {boss} at their own game and ask for a transfer", "effects": {"career": 5, "smarts": 3, "happiness": 4}, "risk": {"chance": 0.55, "effects": {"career": -8, "stress": 7}, "result": "Fired. No notice. No reference."}}
  },
  {
    "id": "work_payday_splurge", "ages": [14, 17], "requires": { "job": "job" },
    "text": "Your first real pay is in your account. You check it three times on the bus home. It looks enormous.",
    "left": { "label": "Save it", "effects": { "money": 20, "smarts": 2, "stress": 1 } },
    "right": { "label": "Spend it all", "effects": { "money": -40, "happiness": 5, "looks": 2, "stress": -2 },
               "result": "Gone by Sunday. You don't know where." }
  , "up": {"label": "Invest it in a side hustle", "effects": {"money": 600, "career": 6, "smarts": 5, "happiness": 4}, "risk": {"chance": 0.45, "effects": {"money": -200, "happiness": -4}, "result": "The hustle did not hustle."}}},
  {
    "id": "work_late_homework", "ages": [14, 17], "requires": { "job": "job" },
    "text": "Your shift ran late and you smell of the job. There's an assignment due at nine, and you haven't written a word.",
    "left": { "label": "Sleep", "effects": { "health": 3, "smarts": -4, "stress": 3 } },
    "right": { "label": "Stay up and finish it", "effects": { "smarts": 3, "health": -4, "stress": 6 } },
    "up": {"label": "Pay a tutor to do half", "effects": {"smarts": 4, "stress": -4, "money": -30}, "risk": {"chance": 0.55, "effects": {"smarts": -4, "karma": -4}, "result": "The teacher spots the tutor's handwriting."}}
  },

  {
    "id": "work_crush_notice", "ages": [14, 17], "requires": { "job": "job", "not_flags": ["work_job_flirting", "work_job_dating"] },
    "text": "{crush} keeps ending up on the same shift as you. Every rota, same days. Coincidence? They smile at the board.",
    "left": { "label": "Keep your head down", "effects": { "stress": 2 } },
    "right": { "label": "Make small talk", "effects": { "happiness": 2, "stress": 2 }, "risk": {"chance": 0.3, "effects": {"happiness": -2, "stress": 2}, "result": "Then it went a bit wrong."}, "coworker": { "crush": 8 } },
    "up": {"label": "Bring them a coffee and a note", "effects": {"happiness": 6, "relationships": 5, "looks": 1}, "risk": {"chance": 0.5, "effects": {"happiness": -6, "stress": 5}, "result": "The note is read aloud at the pass."}}
  },
  {
    "id": "work_crush_flirt", "ages": [14, 17],
    "requires": { "job": "job", "coworker": { "crush": [25, 100] }, "not_flags": ["work_job_flirting", "work_job_dating"] },
    "text": "{crush} borrows your name tag, draws a tiny smiley face on it, and hands it back without a word. Your ears go warm.",
    "left": { "label": "Pretend not to notice", "effects": { "stress": 2 }, "coworker": { "crush": -5 } },
    "right": { "label": "Draw one back", "effects": { "happiness": 3, "stress": 2 }, "coworker": { "crush": 10 }, "set_flags": ["work_job_flirting"] },
    "up": {"label": "Write your number on their hand", "effects": {"happiness": 7, "relationships": 6, "looks": 1}, "risk": {"chance": 0.5, "effects": {"happiness": -7, "relationships": -4}, "result": "It smudges. They have to ask. Awkward."}}
  },
  {
    "id": "work_crush_break_room", "ages": [14, 17],
    "requires": { "job": "job", "flags": ["work_job_flirting"], "not_flags": ["work_job_dating"] },
    "text": "You and {crush} are alone in the break room. The vending machine hums. The kettle clicks off. Nobody is talking.",
    "left": { "label": "Check your phone", "effects": { "stress": 3 }, "coworker": { "crush": -4 } },
    "right": { "label": "Ask about their weekend", "effects": { "happiness": 2, "stress": 2 }, "risk": {"chance": 0.3, "effects": {"happiness": -2, "stress": 2}, "result": "Mostly fine. Mostly."}, "coworker": { "crush": 8 } },
    "up": {"label": "Tell them how you feel", "effects": {"happiness": 8, "relationships": 7, "stress": -3}, "risk": {"chance": 0.55, "effects": {"happiness": -9, "stress": 6}, "result": "They say they're seeing someone. Silence."}}
  },
  {
    "id": "work_crush_ask_out", "ages": [14, 17],
    "requires": { "job": "job", "flags": ["work_job_flirting"], "not_flags": ["work_job_dating", "dating_work_partner"], "coworker": { "crush": [45, 100] } },
    "text": "Shift's over. Everyone's gone. {crush} is lingering by the door, fiddling with their coat zip. This is it.",
    "left": { "label": "Wave and leave", "effects": { "happiness": -4, "stress": 3 }, "coworker": { "crush": -6 } },
    "right": { "label": "Ask them out", "effects": { "happiness": 6, "relationships": 8, "stress": 5 }, "job": { "date": true },
               "set_flags": ["work_job_dating", "dating_work_partner"], "clear_flags": ["work_job_flirting"],
               "result": "They say yes before you finish the sentence." },
    "up": {"label": "Ask them to run away for the weekend", "effects": {"happiness": 9, "relationships": 10, "money": -60}, "risk": {"chance": 0.55, "effects": {"happiness": -9, "relationships": -5}, "result": "'Too soon.' You carry that home."}}
  },
  {
    "id": "work_crush_rejected", "ages": [14, 17], "weight": 5,
    "requires": { "job": "job", "flags": ["work_job_flirting"], "not_flags": ["work_job_dating"], "coworker": { "crush": [-100, 20] } },
    "text": "{crush} has started taking breaks with {rival}. They share crisps on the back step. You can hear the laughing.",
    "left": { "label": "Let it go", "effects": { "happiness": -6, "stress": 3 }, "clear_flags": ["work_job_flirting"] },
    "right": { "label": "Try harder", "effects": { "stress": 5 }, "coworker": { "crush": 6, "rival": -8 } }
  , "up": {"label": "Win them back with a grand gesture", "effects": {"happiness": 6, "relationships": 6, "looks": 1}, "risk": {"chance": 0.6, "effects": {"happiness": -9, "relationships": -6}, "result": "The whole shift watched. They didn't clap."}}},
  {
    "id": "work_dating_secret", "ages": [14, 17], "requires": { "job": "job", "flags": ["work_job_dating"] },
    "text": "{boss} doesn't know you and {crush} are together. {rival} does, and keeps winking at you both, very slowly.",
    "left": { "label": "Keep it quiet", "effects": { "stress": 5 }, "coworker": { "rival": 4 } },
